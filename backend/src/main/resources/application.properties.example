# ============================================================
# VertoEdu Backend — Environment Variable Template
# ============================================================
# Copy this file to application.properties and fill in values.
# Do NOT commit real credentials to version control.
# ============================================================

# Database
DB_URL=jdbc:mysql://localhost:3306/vertoedu?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT Secret (Base64-encoded, minimum 256-bit key)
# Generate with: openssl rand -base64 32
JWT_SECRET=vertoedu_super_secret_key_for_development_2026_abcdefghijklmnopqrstuvwxyz123456

# Admin Emails (comma-separated Google emails that get ADMIN role on first login)
ADMIN_EMAILS=

# OpenAI API
OPENAI_API_KEY=

# OCR API
OCR_API_KEY=

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# CORS Origins
CORS_ORIGINS=http://localhost:5173
