# ============================================================
# VertoEdu Backend — Environment Variable Template
# ============================================================
# Do NOT commit real credentials to version control.
# Use these clearly fake placeholder values as a reference 
# for configuring your local environment variables.
# ============================================================

# Database
DB_PASSWORD=replace_with_your_local_mysql_password

# Google OAuth2
GOOGLE_CLIENT_ID=replace_with_your_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_your_google_client_secret

# JWT Secret (Must be a long, secure random string)
JWT_SECRET=replace_with_your_local_jwt_secret_key

# OpenAI API
OPENAI_API_KEY=replace_with_your_openai_api_key

# OCR Service URL (Defaults to localhost if omitted)
# OCR_SERVICE_URL=http://localhost:8000/ocr

# Admin Emails (Comma-separated list of Google emails that get ADMIN access)
# ADMIN_EMAILS=admin@example.com
